{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheFreakinOG/GHOSTBOUND/schemas/manifest.schema.json",
  "title": "GHOSTBOUND manifest v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "tool", "source", "policy", "secretScan", "files", "mirror"],
  "properties": {
    "schema": { "const": "ghostbound.manifest/v1" },
    "tool": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "const": "ghostbound" }, "version": { "enum": ["0.1.0", "0.2.0"] } }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["objectFormat", "commit", "tree"],
      "properties": { "objectFormat": { "enum": ["sha1", "sha256"] }, "commit": { "$ref": "#/$defs/oid" }, "tree": { "$ref": "#/$defs/oid" } }
    },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "snapshot"],
      "properties": { "sha256": { "$ref": "#/$defs/digest" }, "snapshot": { "const": ".ghostbound/policy.json" } }
    },
    "secretScan": {
      "type": "object", "additionalProperties": false, "required": ["engine", "version", "configSha256", "result"],
      "properties": {
        "engine": { "const": "gitleaks" }, "version": { "type": "string", "pattern": "^8\\.(?:[3-9]\\d|[1-9]\\d{2,})\\.\\d+$" },
        "configSha256": { "$ref": "#/$defs/digest" }, "result": { "const": "passed" }
      }
    },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "destination", "gitMode", "gitBlobOid", "bytes", "sha256"],
        "properties": {
          "source": { "$ref": "#/$defs/path" }, "destination": { "$ref": "#/$defs/path" },
          "gitMode": { "enum": ["100644", "100755"] }, "gitBlobOid": { "$ref": "#/$defs/oid" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 4194304 }, "sha256": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "mirror": {
      "type": "object", "additionalProperties": false, "required": ["fileCount", "totalBytes", "sha256"],
      "properties": { "fileCount": { "type": "integer", "minimum": 1, "maximum": 10000 }, "totalBytes": { "type": "integer", "minimum": 0, "maximum": 67108864 }, "sha256": { "$ref": "#/$defs/digest" } }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "oid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$", "description": "Runtime requires length to match source.objectFormat." },
    "path": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "Runtime also enforces portable path safety, NFC and collisions." }
  }
}
